# Server Port Configuration
PORT=3000

# Minimum Corporate Margin Protection Floor (INR) (Optional, default: 4500)
CURRENT_FLOOR=4500

# Active Bundle Matrix (JSON array of pre-approved catalog bundles)
ACTIVE_MATRIX=[{"name":"Work & Focus Audio Bundle","sku":"BUNDLE_HP_MS","valuation_inr":6500},{"name":"Developer Complete Suite","sku":"BUNDLE_LAP_MS","valuation_inr":51500}]

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_signature_here

# WhatsApp Business / Webhook Verification
WHATSAPP_VERIFY_TOKEN=commerce_ai_secure_verify_token

# Cloud SQL (PostgreSQL) Database Configuration
SQL_HOST=127.0.0.1
SQL_USER=postgres
SQL_PASSWORD=your_database_password
SQL_DB_NAME=commerce_db

